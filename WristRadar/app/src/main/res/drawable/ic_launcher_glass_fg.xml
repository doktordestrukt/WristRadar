<?xml version="1.0" encoding="utf-8"?>
<!--
  Round glass radar (original artwork). Everything sits inside a 30dp radius around the centre,
  within the adaptive-icon safe zone (33dp), so round watch launchers never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- frosted glass disc -->
    <path android:fillColor="#38FFFFFF" android:strokeColor="#D9FFFFFF" android:strokeWidth="1.5"
        android:pathData="M54,24.5 a29.5,29.5 0 1,0 0.01,0 z" />
    <!-- top sheen -->
    <path android:fillColor="#40FFFFFF"
        android:pathData="M30.5,44 A29.5,29.5 0 0,1 77.5,44 C66,39 42,39 30.5,44 Z" />
    <!-- radar rings -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="2.4" android:fillColor="#00000000"
        android:pathData="M54,36 a18,18 0 1,0 0.01,0 z" />
    <path android:strokeColor="#CCFFFFFF" android:strokeWidth="1.8" android:fillColor="#00000000"
        android:pathData="M54,45 a9,9 0 1,0 0.01,0 z" />
    <!-- sweep -->
    <path android:fillColor="#66FFFFFF"
        android:pathData="M54,54 L54,36 A18,18 0 0,1 69.6,45 Z" />
    <!-- blip + centre -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M63.5,46.5 a2.4,2.4 0 1,0 0.01,0 z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,52 a2,2 0 1,0 0.01,0 z" />
</vector>
